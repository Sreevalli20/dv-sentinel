# Caspian Configuration
# Get your API key from: https://dashboard.trycaspianai.com
CASPIAN_API_KEY=your_api_key_here
CASPIAN_BASE_URL=https://api.trycaspianai.com

# Telegram Configuration
# Get your bot token from BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Email Configuration
# This will be the username part of @agents.trycaspianai.com
EMAIL_USERNAME=dv-sentinel

# Application Configuration
PORT=8000
DATABASE_PATH=dv_sentinel.db

# Demo Mode
# Set to true to run without API keys (for testing)
DEMO_MODE=false
